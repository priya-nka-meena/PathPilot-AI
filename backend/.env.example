# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database - prefer a DATABASE_URL in the form: postgres://USER:PASS@HOST:PORT/NAME
# Example: postgres://postgres:password@localhost:5432/pathpilot
DATABASE_URL=

# CORS
CORS_ALLOW_ALL=1
# or CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
